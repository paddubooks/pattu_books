{
  "name": "pattu-books",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/finalize.mjs",
    "preview": "node scripts/serve.mjs",
    "import:content": "node scripts/import-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-catalogue.mjs",
    "prebuild": "node scripts/prepare-catalogue.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "playwright test --config playwright.pages.config.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
